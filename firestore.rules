rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isSuperuser() {
      return signedIn() && (
        request.auth.token.email == "totem1997@gmail.com"
        || userProfile().email == "totem1997@gmail.com"
      );
    }

    function isAdmin() {
      return signedIn()
        && (
          isSuperuser()
          || userProfile().role == "admin"
          || userProfile().role == "superuser"
        );
    }

    function appPermission(appName) {
      return signedIn() ? userProfile().permissions[appName] : null;
    }

    function hasAppRead(appName) {
      let permission = appPermission(appName);
      return signedIn() && (
        isAdmin()
        || permission == true
        || (permission is map && permission.r == true)
      );
    }

    function hasAppCreate(appName) {
      let permission = appPermission(appName);
      return signedIn() && (
        isAdmin()
        || permission == true
        || (permission is map && permission.c == true)
      );
    }

    function hasAppUpdate(appName) {
      let permission = appPermission(appName);
      return signedIn() && (
        isAdmin()
        || permission == true
        || (permission is map && permission.u == true)
      );
    }

    function hasAppDelete(appName) {
      let permission = appPermission(appName);
      return signedIn() && (
        isAdmin()
        || permission == true
        || (permission is map && permission.d == true)
      );
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["email", "displayName", "lastLoginAt"]);
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["email", "displayName", "lastLoginAt"]));
      allow delete: if isAdmin();
    }

    match /leds/{document=**} {
      allow read: if hasAppRead("database") || hasAppRead("calculator");
      allow create: if hasAppCreate("database");
      allow update: if hasAppUpdate("database");
      allow delete: if hasAppDelete("database");
    }

    match /factories/{document=**} {
      allow read: if isAdmin() || hasAppRead("reportGenerator") || hasAppRead("maintenance");
      allow create: if isAdmin() || hasAppCreate("maintenance");
      allow update: if isAdmin() || hasAppUpdate("maintenance");
      allow delete: if isAdmin() || hasAppDelete("maintenance");
    }

    match /customers/{document=**} {
      allow read: if isAdmin() || hasAppRead("reportGenerator") || hasAppRead("salesProjects") || hasAppRead("maintenance");
      allow create: if isAdmin() || hasAppCreate("salesProjects") || hasAppCreate("maintenance");
      allow update: if isAdmin() || hasAppUpdate("salesProjects") || hasAppUpdate("maintenance");
      allow delete: if isAdmin() || hasAppDelete("salesProjects") || hasAppDelete("maintenance");
    }

    match /reports/{reportId} {
      allow read: if hasAppRead("reportGenerator");
      allow create: if hasAppCreate("reportGenerator");
      allow update: if hasAppUpdate("reportGenerator");
      allow delete: if hasAppDelete("reportGenerator");
    }

    match /ics/{recordId} {
      allow read: if hasAppRead("database");
      allow create: if hasAppCreate("database");
      allow update: if hasAppUpdate("database");
      allow delete: if hasAppDelete("database");
    }

    match /psus/{recordId} {
      allow read: if hasAppRead("database");
      allow create: if hasAppCreate("database");
      allow update: if hasAppUpdate("database");
      allow delete: if hasAppDelete("database");
    }

    match /parts/{recordId} {
      allow read: if isAdmin()
        || hasAppRead("database")
        || hasAppRead("calculator")
        || hasAppRead("components")
        || hasAppRead("salesProjects")
        || hasAppRead("reportGenerator");
      allow create: if hasAppCreate("components") || hasAppCreate("salesProjects");
      allow update: if hasAppUpdate("components") || hasAppUpdate("salesProjects");
      allow delete: if hasAppDelete("components") || hasAppDelete("salesProjects");
    }

    match /equipment/{recordId} {
      allow read: if isAdmin()
        || hasAppRead("components")
        || hasAppRead("salesProjects")
        || hasAppRead("reportGenerator");
      allow create: if hasAppCreate("components") || hasAppCreate("salesProjects");
      allow update: if hasAppUpdate("components") || hasAppUpdate("salesProjects");
      allow delete: if hasAppDelete("components") || hasAppDelete("salesProjects");
    }

    match /catalogMetadata/{metadataId} {
      allow read: if isAdmin()
        || hasAppRead("database")
        || hasAppRead("calculator")
        || hasAppRead("components")
        || hasAppRead("salesProjects")
        || hasAppRead("reportGenerator");
      allow create: if hasAppCreate("components") || hasAppCreate("salesProjects");
      allow update: if hasAppUpdate("components") || hasAppUpdate("salesProjects");
      allow delete: if hasAppDelete("components") || hasAppDelete("salesProjects");
    }

    match /_catalogMigrations/{migrationId} {
      allow read: if isAdmin() || hasAppRead("components") || hasAppRead("salesProjects");
      allow create: if hasAppCreate("components") || hasAppCreate("salesProjects");
      allow update: if hasAppUpdate("components") || hasAppUpdate("salesProjects");
      allow delete: if hasAppDelete("components") || hasAppDelete("salesProjects");
    }

    match /salesProjects/{projectId} {
      allow read: if hasAppRead("salesProjects");
      allow create: if hasAppCreate("salesProjects");
      allow update: if hasAppUpdate("salesProjects");
      allow delete: if hasAppDelete("salesProjects");
    }

    match /_counters/{counterId} {
      allow read: if isAdmin() || hasAppRead("components") || hasAppRead("salesProjects") || hasAppRead("reportGenerator") || hasAppRead("maintenance");
      allow create: if isAdmin() || hasAppCreate("components") || hasAppCreate("salesProjects") || hasAppCreate("reportGenerator") || hasAppCreate("maintenance");
      allow update: if isAdmin() || hasAppUpdate("components") || hasAppUpdate("salesProjects") || hasAppUpdate("reportGenerator") || hasAppUpdate("maintenance");
      allow delete: if isAdmin();
    }
  }
}

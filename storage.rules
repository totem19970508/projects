rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function hasDatabaseAccess() {
      return request.auth != null
        && (isAdmin()
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.permissions.database == true);
    }

    match /led-datasheets/{ledId}/{fileName} {
      allow read: if hasDatabaseAccess();
      allow create, update: if hasDatabaseAccess()
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType == "application/pdf";
      allow delete: if hasDatabaseAccess();
    }

    match /sales-projects/{projectId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() && request.resource.size <= 50 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    match /component-datasheets/{componentType}/{componentId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType == "application/pdf";
      allow delete: if isAdmin();
    }
  }
}
